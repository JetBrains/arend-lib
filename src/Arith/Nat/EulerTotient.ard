  \where {
    \lemma helper (a b : Int) : a - (b + a) = negative b => simplify
  } -}

\func coPrimes-eq (n : Nat) : QEquiv {coPrimes n} {SubSet.struct {coPrimes-Inv n}} \cowith {
  | f (k, p) => \let A0 => {?} \in
    (k, inP (\new Monoid.Inv {
      | inv => {?}
      | inv-left => {?}
      | inv-right => {?}
    }))
  | ret => {?}
  | ret_f => {?}
  | f_sec => {?}
}

\func EulerTotient (n : Nat) : Nat => finCard {coPrimes n}

\func function (n m : Nat) (p : IsCoprime n m) (n>0 : 0 < n) (m>0 : 0 < m) (x : coPrimes (n Nat.* m)) : \Sigma (coPrimes n) (coPrimes m) \elim x
  | (x, p) => \let A0 : EuclideanSemiringData.gcd x (n Nat.* m) = 1 => inv p \in (
    (mod_Fin x n>0, \let
      | Am1 => mod_Fin=mod {x} {_} {n>0}
      | A1 : IsCoprime x (n Nat.* m) => IsCoprime.<=gcd (transport (GCD _ _) A0 (EuclideanSemiringData.gcd-isGCD x (n Nat.* m)))
      | A2 : IsCoprime (mod_Fin x n>0) n => \lam z l l1 => A1 z (rewriteI (Nat.divModProp x n) (Semiring.LDiv_+ (Monoid.LDiv.factor-left l1) (transport (Monoid.LDiv {NatSemiring} _) Am1 l))) (Monoid.LDiv.factor-left l1)
      | A2' => IsCoprime.=>gcd A2
      | A2'' => transport (\lam k => GCD k n ide) Am1 A2'
      | A3 => {?} -- gcd-isUnique {_} {x Nat.mod n} {n} (EuclideanSemiringData.gcd-isGCD _ _) A2''
                    \in
      unfold ({?})), (mod_Fin x m>0, {?}))

