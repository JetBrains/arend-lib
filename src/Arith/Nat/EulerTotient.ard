      | inv => negative (a div suc n)
      | inv-right => rewrite mod-mod (rewriteI {3} (divModProp a (suc n) (\lam p => \case p))
          (rewrite (helper _ (pos (suc n) IntRing.* a div pos (suc n)), Ring.negative_*-right {IntEuclidean} {pos (suc n)}) idp))
    }))
  }
  | f_sec x => rewrite IntEuclidean.natMod=mod (\case \elim x \with {
